<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Utöka res.partner form med UAP-flik -->
  <record id="view_partner_uap_form" model="ir.ui.view">
    <field name="name">res.partner.uap.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- UAP-flik efter inköp/försäljning -->
      <page name="sales_purchases" position="after">
        <page string="UAP" name="uap_tab">
          <group string="Organisation">
            <field name="uap_encounter_id" placeholder="SWE_1973_UFOSE"/>
            <field name="uap_org_type"/>
            <field name="uap_region"/>
            <field name="uap_discourse_level"/>
            <field name="uap_official_response"/>
          </group>
          <group string="Research Notes" col="1">
            <field name="uap_research_notes" nolabel="1"
                   placeholder="[BAK] bakgrund  [OFF] officiell respons  [SRC] källa"/>
          </group>
          <group string="Databases" col="1">
            <field name="uap_database_ids" nolabel="1">
              <list>
                <field name="name"/>
                <field name="db_type"/>
                <field name="db_url" widget="url"/>
                <field name="encounter_count" string="Encounters"/>
              </list>
            </field>
          </group>
        </page>
      </page>

    </field>
  </record>

  <!-- Action: organisationer (partners med uap_org_type satt) -->
  <record id="action_uap_organisations" model="ir.actions.act_window">
    <field name="name">Organisations</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,kanban,form</field>
    <field name="domain">[('uap_org_type', '!=', False)]</field>
    <field name="context">{'default_is_company': True}</field>
  </record>

</odoo>
