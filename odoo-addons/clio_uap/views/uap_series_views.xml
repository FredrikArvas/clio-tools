<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ══════════════════════════════════════════════════════
       Action — definieras FÖRST så form-view kan referera den
  ══════════════════════════════════════════════════════ -->
  <record id="action_uap_series" model="ir.actions.act_window">
    <field name="name">Event Series</field>
    <field name="res_model">uap.series</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{'search_default_pending': 1}</field>
  </record>

  <!-- ══════════════════════════════════════════════════════
       List view
  ══════════════════════════════════════════════════════ -->
  <record id="view_uap_series_list" model="ir.ui.view">
    <field name="name">uap.series.list</field>
    <field name="model">uap.series</field>
    <field name="arch" type="xml">
      <list string="Event Series" decoration-muted="status == 'rejected'">
        <field name="name"/>
        <field name="series_type"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="country_ids" widget="many2many_tags"/>
        <field name="encounter_count" string="Encounters"/>
        <field name="confidence" widget="progressbar"/>
        <field name="status" widget="badge"
               decoration-success="status == 'confirmed'"
               decoration-info="status == 'auto_confirmed'"
               decoration-warning="status == 'auto_pending'"
               decoration-danger="status == 'rejected'"/>
      </list>
    </field>
  </record>

  <!-- ══════════════════════════════════════════════════════
       Kanban view — review queue
  ══════════════════════════════════════════════════════ -->
  <record id="view_uap_series_kanban" model="ir.ui.view">
    <field name="name">uap.series.kanban</field>
    <field name="model">uap.series</field>
    <field name="arch" type="xml">
      <kanban default_group_by="status" class="o_kanban_small_column">
        <field name="name"/>
        <field name="series_type"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="encounter_count"/>
        <field name="confidence"/>
        <field name="status"/>
        <field name="country_ids"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong><field name="name"/></strong>
              <div class="text-muted small">
                <field name="series_type"/>
              </div>
              <div class="mt-1">
                <span class="badge bg-secondary">
                  <field name="encounter_count"/> encounters
                </span>
                <span class="ms-1 text-muted small">
                  <field name="date_start"/> – <field name="date_end"/>
                </span>
              </div>
              <div class="mt-1">
                Confidence: <field name="confidence"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ══════════════════════════════════════════════════════
       Form view
  ══════════════════════════════════════════════════════ -->
  <record id="view_uap_series_form" model="ir.ui.view">
    <field name="name">uap.series.form</field>
    <field name="model">uap.series</field>
    <field name="arch" type="xml">
      <form string="Event Series">
        <header>
          <button name="action_confirm" type="object"
                  string="Confirm Series" class="btn-primary"
                  invisible="status not in ('auto_pending', 'auto_confirmed')"/>
          <button name="action_reject" type="object"
                  string="Reject" class="btn-secondary"
                  invisible="status in ('rejected', 'confirmed')"/>
          <field name="status" widget="statusbar"
                 statusbar_visible="auto_pending,auto_confirmed,confirmed,rejected"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button class="oe_stat_button" type="object"
                    name="action_open_encounters" icon="fa-map-marker">
              <field name="encounter_count" widget="statinfo" string="Encounters"/>
            </button>
          </div>
          <div class="oe_title">
            <h1><field name="name" placeholder="Series name"/></h1>
          </div>

          <group>
            <group string="Classification">
              <field name="series_type"/>
              <field name="country_ids" widget="many2many_tags"/>
            </group>
            <group string="Timeline">
              <field name="date_start"/>
              <field name="date_end"/>
            </group>
          </group>

          <group string="Geography">
            <group>
              <field name="geo_lat"/>
              <field name="geo_lng"/>
            </group>
            <group>
              <field name="bbox_km"/>
            </group>
          </group>

          <group string="Auto-detection">
            <field name="confidence"/>
          </group>

          <notebook>
            <page string="Encounters">
              <field name="encounter_ids" nolabel="1">
                <list>
                  <field name="encounter_id"/>
                  <field name="title_en"/>
                  <field name="date_observed"/>
                  <field name="country_id"/>
                  <field name="status" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Notes">
              <field name="notes" nolabel="1"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ══════════════════════════════════════════════════════
       Search view
  ══════════════════════════════════════════════════════ -->
  <record id="view_uap_series_search" model="ir.ui.view">
    <field name="name">uap.series.search</field>
    <field name="model">uap.series</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="country_ids"/>
        <filter name="pending"   string="Needs Review" domain="[('status','=','auto_pending')]"/>
        <filter name="confirmed" string="Confirmed"    domain="[('status','in',('auto_confirmed','confirmed'))]"/>
        <filter name="rejected"  string="Rejected"     domain="[('status','=','rejected')]"/>
        <group expand="0" string="Group By">
          <filter name="by_type"    string="Type"    context="{'group_by': 'series_type'}"/>
          <filter name="by_status"  string="Status"  context="{'group_by': 'status'}"/>
          <filter name="by_country" string="Country" context="{'group_by': 'country_ids'}"/>
        </group>
      </search>
    </field>
  </record>

</odoo>
