            sequence="18"/>

  <!-- Organisations -->
  <menuitem id="menu_uap_organisations"
            name="Organisations"
            parent="menu_uap_root"
            action="action_uap_organisations"
            sequence="20"/>

  <!-- Databases -->
  <menuitem id="menu_uap_databases"
            name="Databases"
            parent="menu_uap_root"
            action="action_uap_database"
            sequence="30"/>

  <!-- Sources -->
  <menuitem id="menu_uap_sources"
