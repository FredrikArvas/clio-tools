<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── clio.vigil.subscriber ─────────────────────────────────────────── -->
  <!-- Prenumerant/Användare ser och redigerar bara sin egen rad. -->
  <record id="rule_vigil_subscriber_own" model="ir.rule">
    <field name="name">Vigil: prenumerant ser bara sin egen rad</field>
    <field name="model_id" ref="model_clio_vigil_subscriber"/>
    <field name="groups" eval="[(4, ref('group_vigil_subscriber'))]"/>
    <field name="domain_force">[('partner_id.user_ids', 'in', [user.id])]</field>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- ── clio.vigil.keyword ────────────────────────────────────────────── -->
  <!-- Prenumerant/Användare ser och redigerar bara sina egna sökord. -->
  <record id="rule_vigil_keyword_own" model="ir.rule">
    <field name="name">Vigil: prenumerant ser bara sina egna sökord</field>
    <field name="model_id" ref="model_clio_vigil_keyword"/>
    <field name="groups" eval="[(4, ref('group_vigil_subscriber'))]"/>
    <field name="domain_force">[('subscriber_id.partner_id.user_ids', 'in', [user.id])]</field>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

  <!-- ── clio.vigil.delivery ───────────────────────────────────────────── -->
  <!-- Prenumerant/Användare ser bara sina egna leveranser. -->
  <record id="rule_vigil_delivery_own" model="ir.rule">
    <field name="name">Vigil: prenumerant ser bara sina egna leveranser</field>
    <field name="model_id" ref="model_clio_vigil_delivery"/>
    <field name="groups" eval="[(4, ref('group_vigil_subscriber'))]"/>
    <field name="domain_force">[('subscriber_id.partner_id.user_ids', 'in', [user.id])]</field>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <!-- ── clio.vigil.resend.request ─────────────────────────────────────── -->
  <!-- Prenumerant/Användare ser och skapar bara sina egna resend-begäran. -->
  <record id="rule_vigil_resend_own" model="ir.rule">
    <field name="name">Vigil: prenumerant ser bara sina egna resend-begäran</field>
    <field name="model_id" ref="model_clio_vigil_resend_request"/>
    <field name="groups" eval="[(4, ref('group_vigil_subscriber'))]"/>
    <field name="domain_force">[('subscriber_id.partner_id.user_ids', 'in', [user.id])]</field>
    <field name="perm_read"   eval="True"/>
    <field name="perm_write"  eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="False"/>
  </record>

</odoo>
