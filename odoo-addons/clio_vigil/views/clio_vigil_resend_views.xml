<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Guide: Skicka om utskick ──────────────────────────────────────── -->

  <record id="view_clio_vigil_resend_wizard_form" model="ir.ui.view">
    <field name="name">clio.vigil.resend.wizard.form</field>
    <field name="model">clio.vigil.resend.wizard</field>
    <field name="arch" type="xml">
      <form string="Skicka om utskick">
        <group>
          <field name="subscriber_ids"    string="Prenumeranter"
                 widget="many2many_tags"  readonly="1"/>
          <field name="subscriber_count"  string="Antal"         readonly="1"/>
          <field name="digest_date"       string="Digestdatum"/>
        </group>
        <footer>
          <button name="action_confirm" string="Skapa begäran"
                  type="object" class="btn-primary"/>
          <button string="Avbryt" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <!-- ── Server action — syns i Actions-menyn på lista och formulär ─────── -->

  <record id="action_server_clio_vigil_resend" model="ir.actions.server">
    <field name="name">Skicka om utskick</field>
    <field name="model_id" ref="model_clio_vigil_subscriber"/>
    <field name="binding_model_id" ref="model_clio_vigil_subscriber"/>
    <field name="binding_view_types">list,form</field>
    <field name="state">code</field>
    <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Skicka om utskick',
    'res_model': 'clio.vigil.resend.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_ids': records.ids},
}
    </field>
  </record>

  <!-- ── Action för stat-knapp: lista begäranden per prenumerant ────────── -->

  <record id="action_clio_vigil_resend_sub" model="ir.actions.act_window">
    <field name="name">Skicka-om begäranden</field>
    <field name="res_model">clio.vigil.resend.request</field>
    <field name="view_mode">list</field>
    <field name="domain">[('subscriber_id','=',active_id)]</field>
    <field name="context">{'default_subscriber_id': active_id}</field>
  </record>

  <!-- ── Listvy: resend requests ────────────────────────────────────────── -->

  <record id="view_clio_vigil_resend_request_list" model="ir.ui.view">
    <field name="name">clio.vigil.resend.request.list</field>
    <field name="model">clio.vigil.resend.request</field>
    <field name="arch" type="xml">
      <list string="Skicka-om begäranden" default_order="created_at desc"
            decoration-success="state == 'sent'"
            decoration-danger="state == 'failed'">
        <field name="subscriber_id"  string="Prenumerant"/>
        <field name="digest_date"    string="Digestdatum"/>
        <field name="state"          string="Status"   widget="badge"
               decoration-success="state == 'sent'"
               decoration-danger="state == 'failed'"
               decoration-warning="state == 'pending'"/>
        <field name="created_at"     string="Skapad"/>
        <field name="sent_at"        string="Skickad"  optional="show"/>
        <field name="result"         string="Resultat" optional="show"/>
      </list>
    </field>
  </record>

</odoo>
