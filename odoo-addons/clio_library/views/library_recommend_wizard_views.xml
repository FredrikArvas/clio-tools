<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_recommend_wizard_form" model="ir.ui.view">
        <field name="name">library.recommend.wizard.form</field>
        <field name="model">library.recommend.wizard</field>
        <field name="arch" type="xml">
            <form string="Bokrekommendation">
                <sheet>
                    <group string="Deltagare">
                        <field name="member_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group string="Uteslut böcker (valfritt)">
                        <field name="blacklist_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <group string="Rekommendation" invisible="not recommendation">
                        <field name="recommendation" nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_recommend" type="object"
                            string="Rekommendera" class="btn-primary"/>
                    <button string="Stäng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_library_recommend_wizard" model="ir.actions.act_window">
        <field name="name">Rekommendera</field>
        <field name="res_model">library.recommend.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
