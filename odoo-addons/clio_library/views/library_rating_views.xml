<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_library_rating_list" model="ir.ui.view">
        <field name="name">library.rating.list</field>
        <field name="model">library.rating</field>
        <field name="arch" type="xml">
            <list string="Betyg">
                <field name="book_id"/>
                <field name="user_id"/>
                <field name="rating"/>
                <field name="date_read"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="view_library_rating_form" model="ir.ui.view">
        <field name="name">library.rating.form</field>
        <field name="model">library.rating</field>
        <field name="arch" type="xml">
            <form string="Betyg">
                <sheet>
                    <group>
                        <field name="book_id"/>
                        <field name="user_id"/>
                        <field name="rating"/>
                        <field name="date_read"/>
                    </group>
                    <group string="Anteckning">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_rating" model="ir.actions.act_window">
        <field name="name">Betyg</field>
        <field name="res_model">library.rating</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
