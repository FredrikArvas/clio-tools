# clio-odoo-pw-rotation — .env.example
# Kopiera relevant del till clio-tools/.env och fyll i riktiga värden.
# ALDRIG checka in .env — täcks av .gitignore.

# ── Konton att rotera ─────────────────────────────────────────────────────────
# Format: ROTATE_<LABEL>_LOGIN + ROTATE_<LABEL>_PASSWORD
# Lägg till ett par per konto. LABEL är godtycklig men unik (ADMIN, FREDRIK, …).

ROTATE_ADMIN_LOGIN=admin
ROTATE_ADMIN_PASSWORD=ChangeMe_SuperSecret_123!

ROTATE_FREDRIK_LOGIN=user@example.com
ROTATE_FREDRIK_PASSWORD=ChangeMe_AnotherSecret_456!

# ── Databaser per instans ─────────────────────────────────────────────────────
# Kommaseparerad lista. Verifierad 2026-11-14.

ROTATE_DATABASES_19=aiab,afu_archives,aiab19b,aiab19e,examensbyran,examensbyran_t3,gsf,gsf_t1,gsf_t3,konfident,mrmusic,sverigetipset_t2

ROTATE_DATABASES_18=ssf
