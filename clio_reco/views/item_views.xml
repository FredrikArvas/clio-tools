<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clio_reco_item_list" model="ir.ui.view">
        <field name="name">clio.reco.item.list</field>
        <field name="model">clio.reco.item</field>
        <field name="arch" type="xml">
            <list string="Rekommendationer">
                <field name="image_1920" widget="image" options="{'size': [38, 38]}"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="author"/>
                <field name="year"/>
                <field name="genre_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="is_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_clio_reco_item_kanban" model="ir.ui.view">
        <field name="name">clio.reco.item.kanban</field>
        <field name="model">clio.reco.item</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="item_type"/>
                <field name="image_1920"/>
                <field name="author"/>
                <field name="year"/>
                <field name="is_published"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <field name="image_1920" widget="image"/>
                        </div>
                        <div class="o_kanban_details">
                            <strong><field name="name"/></strong>
                            <div class="o_kanban_tags_section">
                                <field name="genre_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>
                            <div>
                                <span t-if="record.author.value" class="text-muted">
                                    <t t-esc="record.author.value"/>
                                    <t t-if="record.year.value">, <t t-esc="record.year.value"/></t>
                                </span>
                            </div>
                            <div>
                                <span t-attf-class="badge #{record.item_type.value === 'book' ? 'text-bg-success' : record.item_type.value === 'film' ? 'text-bg-primary' : 'text-bg-secondary'}">
                                    <t t-esc="record.item_type.value"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_clio_reco_item_form" model="ir.ui.view">
        <field name="name">clio.reco.item.form</field>
        <field name="model">clio.reco.item</field>
        <field name="arch" type="xml">
            <form string="Rekommendation">
                <sheet>
                    <field name="image_1920" widget="image" class="o_field_image_top" options="{'size': [128, 128]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Titel"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="item_type"/>
                            <field name="author"/>
                            <field name="year"/>
                            <field name="genre_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="is_published"/>
                        </group>
                        <group>
                            <field name="url" widget="url"/>
                            <field name="isbn" invisible="item_type != 'book'"/>
                            <field name="tmdb_id" invisible="item_type != 'film'"/>
                            <field name="domain" invisible="item_type != 'link'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Beskrivning">
                            <field name="description"/>
                        </page>
                        <page string="Logg">
                            <div class="o_chatter_button_new_message"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_clio_reco_item_all" model="ir.actions.act_window">
        <field name="name">Alla rekommendationer</field>
        <field name="res_model">clio.reco.item</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_clio_reco_item_books" model="ir.actions.act_window">
        <field name="name">Böcker</field>
        <field name="res_model">clio.reco.item</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_item_type': 'book'}</field>
    </record>

    <record id="action_clio_reco_item_films" model="ir.actions.act_window">
        <field name="name">Filmer</field>
        <field name="res_model">clio.reco.item</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_item_type': 'film'}</field>
    </record>

    <record id="action_clio_reco_item_links" model="ir.actions.act_window">
        <field name="name">Länkar</field>
        <field name="res_model">clio.reco.item</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_item_type': 'link'}</field>
    </record>

    <!-- Sökvy med filter på item_type -->
    <record id="view_clio_reco_item_search" model="ir.ui.view">
        <field name="name">clio.reco.item.search</field>
        <field name="model">clio.reco.item</field>
        <field name="arch" type="xml">
            <search string="Sök rekommendationer">
                <field name="name"/>
                <field name="author"/>
                <field name="genre_ids"/>
                <filter name="item_type_book" string="Böcker" domain="[('item_type','=','book')]"/>
                <filter name="item_type_film" string="Filmer" domain="[('item_type','=','film')]"/>
                <filter name="item_type_link" string="Länkar" domain="[('item_type','=','link')]"/>
                <separator/>
                <filter name="published" string="Publicerade" domain="[('is_published','=',True)]"/>
                <separator/>
                <filter name="group_type" string="Typ" context="{'group_by': 'item_type'}"/>
                <filter name="group_genre" string="Genre" context="{'group_by': 'genre_ids'}"/>
            </search>
        </field>
    </record>

</odoo>
