<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clio_reco_context_list" model="ir.ui.view">
        <field name="name">clio.reco.context.list</field>
        <field name="model">clio.reco.context</field>
        <field name="arch" type="xml">
            <list string="Sammanhang">
                <field name="name"/>
                <field name="question"/>
                <field name="scale_min"/>
                <field name="scale_max"/>
                <field name="is_sensitive" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'approved'"
                    decoration-warning="state == 'nominated'"
                    decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_clio_reco_context_form" model="ir.ui.view">
        <field name="name">clio.reco.context.form</field>
        <field name="model">clio.reco.context</field>
        <field name="arch" type="xml">
            <form string="Sammanhang">
                <header>
                    <button name="action_approve" type="object" string="Godkänn"
                        invisible="state != 'nominated'"
                        groups="clio_reco.group_clio_reco_manager"
                        class="btn-primary"/>
                    <button name="action_reject" type="object" string="Avslå"
                        invisible="state != 'nominated'"
                        groups="clio_reco.group_clio_reco_manager"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="nominated,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="question"/>
                            <field name="is_sensitive"/>
                        </group>
                        <group>
                            <field name="scale_min"/>
                            <field name="scale_max"/>
                            <field name="scale_label_min"/>
                            <field name="scale_label_max"/>
                        </group>
                    </group>
                    <group>
                        <field name="work_type_ids" widget="many2many_tags"/>
                        <field name="rater_group_ids" widget="many2many_tags"/>
                        <field name="nominated_by_id"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_clio_reco_context_search" model="ir.ui.view">
        <field name="name">clio.reco.context.search</field>
        <field name="model">clio.reco.context</field>
        <field name="arch" type="xml">
            <search string="Sammanhang">
                <field name="name"/>
                <filter name="filter_approved" string="Godkända"
                    domain="[('state', '=', 'approved')]"/>
                <filter name="filter_nominated" string="Nominerade"
                    domain="[('state', '=', 'nominated')]"/>
                <filter name="filter_sensitive" string="Känsliga"
                    domain="[('is_sensitive', '=', True)]"/>
                <group expand="0" string="Gruppera efter">
                    <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clio_reco_context" model="ir.actions.act_window">
        <field name="name">Sammanhang</field>
        <field name="res_model">clio.reco.context</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clio_reco_context_search"/>
        <field name="context">{'search_default_filter_approved': 1}</field>
    </record>

</odoo>
