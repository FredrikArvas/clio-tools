<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clio_reco_genre_list" model="ir.ui.view">
        <field name="name">clio.reco.genre.list</field>
        <field name="model">clio.reco.genre</field>
        <field name="arch" type="xml">
            <list string="Genrer">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_clio_reco_genre_form" model="ir.ui.view">
        <field name="name">clio.reco.genre.form</field>
        <field name="model">clio.reco.genre</field>
        <field name="arch" type="xml">
            <form string="Genre">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clio_reco_genre" model="ir.actions.act_window">
        <field name="name">Genrer</field>
        <field name="res_model">clio.reco.genre</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
