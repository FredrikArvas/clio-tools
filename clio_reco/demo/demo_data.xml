<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Genrer -->
    <record id="genre_sf" model="clio.reco.genre">
        <field name="name">Science Fiction</field>
        <field name="color">1</field>
    </record>

    <record id="genre_thriller" model="clio.reco.genre">
        <field name="name">Thriller</field>
        <field name="color">2</field>
    </record>

    <record id="genre_tech" model="clio.reco.genre">
        <field name="name">Teknik &amp; AI</field>
        <field name="color">3</field>
    </record>

    <record id="genre_documentary" model="clio.reco.genre">
        <field name="name">Dokumentär</field>
        <field name="color">4</field>
    </record>

    <!-- Böcker -->
    <record id="item_book_1" model="clio.reco.item">
        <field name="name">Sapiens: En kort historik över mänskligheten</field>
        <field name="item_type">book</field>
        <field name="author">Yuval Noah Harari</field>
        <field name="year">2011</field>
        <field name="isbn">9789113079967</field>
        <field name="genre_ids" eval="[(4, ref('genre_tech'))]"/>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;En sweeping berättelse om den mänskliga artens historia — från stenålder till AI-era.&lt;/p&gt;</field>
    </record>

    <record id="item_book_2" model="clio.reco.item">
        <field name="name">The Alignment Problem</field>
        <field name="item_type">book</field>
        <field name="author">Brian Christian</field>
        <field name="year">2020</field>
        <field name="isbn">9780393635829</field>
        <field name="genre_ids" eval="[(4, ref('genre_tech'))]"/>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;Om svårigheterna med att göra AI-system som faktiskt gör vad vi menar.&lt;/p&gt;</field>
    </record>

    <!-- Film -->
    <record id="item_film_1" model="clio.reco.item">
        <field name="name">Ex Machina</field>
        <field name="item_type">film</field>
        <field name="author">Alex Garland</field>
        <field name="year">2014</field>
        <field name="tmdb_id">264660</field>
        <field name="genre_ids" eval="[(4, ref('genre_sf'))]"/>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;Programmerare bjuds in för att testa en humanoid AI — med oväntade konsekvenser.&lt;/p&gt;</field>
    </record>

    <!-- Länk -->
    <record id="item_link_1" model="clio.reco.item">
        <field name="name">Anthropic Model Spec</field>
        <field name="item_type">link</field>
        <field name="url">https://www.anthropic.com/research/model-spec</field>
        <field name="genre_ids" eval="[(4, ref('genre_tech'))]"/>
        <field name="is_published" eval="True"/>
        <field name="description">&lt;p&gt;Anthropics publika spec för hur Claude ska tänka och agera — en grundtext för AI-alignment.&lt;/p&gt;</field>
    </record>

</odoo>
